# コピーして .env として保存（.env は git 管理外）
#   cp .env.example .env

# --- 楽天トラベル API ------------------------------------------------------
# Rakuten Web Service (https://webservice.rakuten.co.jp/) でアプリ登録して取得
RAKUTEN_APP_ID=
# 同じ画面の Access Key（pk_ で始まる）。2026/2 の新仕様で必須
RAKUTEN_ACCESS_KEY=
# アプリ登録の「Allowed websites」に入れたドメインの URL（Referer として送る）
RAKUTEN_REFERER=https://github.com/hir0hir0/general

# --- 通知チャネル（カンマ区切り: ntfy,line,gmail） ---------------------------
NOTIFY_CHANNELS=ntfy

# ntfy.sh（推奨・最短）: スマホの ntfy アプリで同じトピックを購読する
#   トピック名は推測されにくいものにする（例: f1suzuka-hotel-xk3q9）
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# エラー通知用（未設定なら "<NTFY_TOPIC>-errors"）
NTFY_ERROR_TOPIC=
# セルフホスト ntfy で認証がある場合のみ
NTFY_TOKEN=

# LINE Messaging API（LINE Developers でチャネル作成 → 長期アクセストークン発行）
#   LINE_USER_ID は自分のユーザーID（Developers コンソールの「あなたのユーザーID」）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# Gmail（2 段階認証 + アプリパスワード）
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_TO=

# --- 任意 -----------------------------------------------------------------
# 状態・履歴・デバッグ出力の保存先（既定: ./data）
#F1HOTEL_DATA_DIR=/volume1/docker/f1-hotel-monitor/data
# Playwright の既定 Chromium 以外を使う場合（例: 環境に既にある Chromium）
#PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# --- 自動予約（スーパーホテル開放日など） -------------------------------------
# 1 にすると自動予約が有効になる。config.toml の booking.enabled = true も必要
F1HOTEL_BOOKING=0
# 宿泊者情報（予約フォームに入る値）
GUEST_NAME=
GUEST_KANA=
GUEST_PHONE=
GUEST_EMAIL=
GUEST_POSTAL=
GUEST_ADDRESS=
# 会員ログインする場合
SUPERHOTEL_MEMBER_ID=
SUPERHOTEL_PASSWORD=
#TOYOKO_MEMBER_ID=
#TOYOKO_PASSWORD=
